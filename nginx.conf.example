# Nginx Reverse Proxy Configuration for fab-creations.com
# Place this at: /etc/nginx/sites-available/fab-creations.com
# Enable with: sudo ln -s /etc/nginx/sites-available/fab-creations.com /etc/nginx/sites-enabled/
# Then obtain SSL: sudo certbot --nginx -d fab-creations.com -d www.fab-creations.com

server {
    listen 80;
    listen [::]:80;
    server_name fab-creations.com www.fab-creations.com;

    # Allow large payload for high-res jewelry image uploads
    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:4050;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
