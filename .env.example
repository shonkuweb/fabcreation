# Cloudflare R2 Storage Credentials (obtain from Cloudflare Dashboard > R2)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_BUCKET_NAME="your-bucket-name"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_PUBLIC_URL="https://pub-your-bucket-id.r2.dev"

# Admin Panel Security
ADMIN_PASSWORD="change-this-to-a-strong-password"
ADMIN_SESSION_SECRET="generate-a-random-32-character-secret"

# Database Directory (defaults to /app/data in Docker or ./data locally)
DATABASE_DIR="/app/data"

# Host Port (Default: 4050)
HOST_PORT=4050

# Resend Email Configuration for OTP Verification
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Fab Creations <otp@fab-creations.com>"
